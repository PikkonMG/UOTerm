# ---------------------------------------------------------------------------
# Ultima Online client data. Copyrighted game files. Never commit them.
# The `deny-assets` CI job fails the build if any of these are tracked.
# ---------------------------------------------------------------------------
*.mul
*.uop
*.idx
*.def
*.enu
*.rle
Client.exe
client.exe

# ---------------------------------------------------------------------------
# Secrets and credentials. Passwords go in UO_PASS. HTTP tokens go in
# UOTERM_API_TOKEN. TypeSafe keys go in TYPESAFE_API_KEY (local .env).
# Never commit those values.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
secrets/
*.pem
*.key
*.p12
*.pfx
*.crt
*.keystore
*.jks
.netrc
.npmrc.local
credentials
credentials.*

# ---------------------------------------------------------------------------
# Local operator config. Each has a committed `.example` to copy from.
# Do not commit host, uopath, markers, or account files from a live machine.
# ---------------------------------------------------------------------------
uoterm.toml
!uoterm.toml.example
profiles/*.toml
!profiles/example.toml
!profiles/aldreth.toml
!profiles/cedric.toml
shards/*.toml
!shards/britannia.toml
personas/*.toml
!personas/lumberjack.toml
!personas/aldreth.toml
!personas/cedric.toml
!personas/traveler.toml

# ---------------------------------------------------------------------------
# Build output
# ---------------------------------------------------------------------------
/target/
**/*.rs.bk
*.pdb

# ---------------------------------------------------------------------------
# Test and run artifacts
# ---------------------------------------------------------------------------
*.log
harvest.jsonl
*.jsonl
core
core.*
perf.data
perf.data.old
flamegraph.svg
*.profraw
/tmp/
.uoterm-local/
mara.log
feedback_drafts.json
/*.png
/*.jpg
/*.jpeg

# ---------------------------------------------------------------------------
# Session and tool caches that do not belong in this tree
# ---------------------------------------------------------------------------
.grok/

