{
  "name": "uoterm-web-client",
  "version": "0.0.0",
  "private": true,
  "description": "The UOTerm play window for the browser",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "wasm": "node scripts/build-wasm.mjs",
    "theme": "node scripts/theme-css.mjs",
    "dev": "npm run wasm && npm run theme && vite",
    "build": "npm run wasm && npm run theme && tsc --noEmit && vite build",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
    "preact": "11.0.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@preact/preset-vite": "2.10.6",
    "@testing-library/preact": "3.2.4",
    "@types/node": "24.19.1",
    "@types/three": "0.186.0",
    "eslint": "10.12.0",
    "jsdom": "30.1.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
